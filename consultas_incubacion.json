{
 "conector": "Idealcontrol MCP",
 "herramienta": "aggregate",
 "nota": "Las respuestas grandes superan el límite de contexto y se guardan en archivo: leerlas desde ese archivo. Si una respuesta llega en línea siendo grande, agregar al final del pipeline un $addFields _pad para forzar el archivo y luego descartar _pad.",
 "datasets": {
  "incubadoras_tags": {
   "source": "cluster3/sensen_temperature_db/tag",
   "pipeline": [
    {
     "$match": {
      "shortName": {
       "$in": [
        "TEMP",
        "PORCENTAJE_DESARROLLO",
        "UTA_ACUMULADA",
        "BANDA_MIN_TEMP",
        "BANDA_MAX_TEMP",
        "DESHABILITAR_LOTE",
        "BIT_ALARMA_TEMP_ALTA",
        "BIT_ALARMA_TEMP_BAJA",
        "TEST_1_%",
        "TEST_2_%",
        "TEST_3_%",
        "TEST_4_%",
        "TIPO_ESPECIE",
        "TIPO_TEST"
       ]
      }
     }
    },
    {
     "$group": {
      "_id": "$locationId",
      "kv": {
       "$push": {
        "k": "$shortName",
        "v": "$lastValue"
       }
      },
      "pct_tag": {
       "$max": {
        "$cond": [
         {
          "$eq": [
           "$shortName",
           "PORCENTAJE_DESARROLLO"
          ]
         },
         {
          "$toString": "$_id"
         },
         null
        ]
       }
      },
      "temp_tag": {
       "$max": {
        "$cond": [
         {
          "$eq": [
           "$shortName",
           "TEMP"
          ]
         },
         {
          "$toString": "$_id"
         },
         null
        ]
       }
      }
     }
    },
    {
     "$match": {
      "pct_tag": {
       "$ne": null
      }
     }
    },
    {
     "$replaceRoot": {
      "newRoot": {
       "$mergeObjects": [
        {
         "$arrayToObject": "$kv"
        },
        {
         "location_id": {
          "$toString": "$_id"
         },
         "pct_tag": "$pct_tag",
         "temp_tag": "$temp_tag"
        }
       ]
      }
     }
    },
    {
     "$project": {
      "alarma_alta_plc": "$BIT_ALARMA_TEMP_ALTA",
      "alarma_baja_plc": "$BIT_ALARMA_TEMP_BAJA",
      "banda_max_c": "$BANDA_MAX_TEMP",
      "banda_min_c": "$BANDA_MIN_TEMP",
      "deshabilitar_lote": "$DESHABILITAR_LOTE",
      "especie_codigo": "$TIPO_ESPECIE",
      "location_id": 1,
      "pct_desarrollo": "$PORCENTAJE_DESARROLLO",
      "pct_tag": 1,
      "temp_c": "$TEMP",
      "temp_tag": 1,
      "test_1": "$TEST_1_%",
      "test_2": "$TEST_2_%",
      "test_3": "$TEST_3_%",
      "test_4": "$TEST_4_%",
      "tipo_test": "$TIPO_TEST",
      "uta_acumulada": "$UTA_ACUMULADA"
     }
    },
    {
     "$sort": {
      "location_id": 1
     }
    }
   ],
   "formato": "filas tal cual"
  },
  "ubicaciones": {
   "source": "cluster3/sensen_temperature_db/location",
   "pipeline": [
    {
     "$project": {
      "_id": 0,
      "incubadora": "$name",
      "location_id": {
       "$toString": "$_id"
      },
