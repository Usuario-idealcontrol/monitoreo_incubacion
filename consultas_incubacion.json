  "reuso_tags": {
   "source": "cluster1/freshwater/tag",
   "pipeline": [
    {
     "$match": {
      "zoneId": {
       "$oid": "69eb961c4090f46e6bac5cbe"
      }
     }
    },
    {
     "$project": {
      "id": {
       "$toString": "$_id"
      },
      "k": {
       "$arrayElemAt": [
        {
         "$split": [
          "$shortName",
          "-ZJ"
         ]
        },
        0
       ]
      },
      "v": "$lastValue",
      "zj": {
       "$arrayElemAt": [
        {
         "$split": [
          "$shortName",
          "-"
         ]
        },
        -1
       ]
      }
     }
    },
    {
     "$match": {
      "k": {
       "$in": [
        "TEMP",
        "UTA_ACUMULADA",
        "PORCENTAJE_DESARROLLO",
        "HABILITAR_ZJ",
        "LOOP_ACTIVO",
        "TIPO_TEST",
        "TIPO_ESPECIE",
        "BANDA_MIN_TEMP",
        "BANDA_MAX_TEMP",
        "BIT_ALARMA_ALTA_TEMP",
        "BIT_ALARMA_BAJA_TEMP",
        "TEST_1",
        "TEST_2",
        "TEST_3",
        "TEST_4",
        "TEST_5"
       ]
      }
     }
    },
    {
     "$group": {
      "_id": "$zj",
      "kv": {
       "$push": {
        "k": "$k",
        "v": "$v"
       }
      },
      "temp_tag": {
       "$max": {
        "$cond": [
         {
          "$eq": [
           "$k",
           "TEMP"
          ]
         },
         "$id",
         null
        ]
       }
      },
      "uta_tag": {
       "$max": {
        "$cond": [
         {
          "$eq": [
           "$k",
           "UTA_ACUMULADA"
          ]
         },
         "$id",
         null
        ]
       }
      }
     }
    },
    {
     "$replaceRoot": {
      "newRoot": {
       "$mergeObjects": [
        {
         "$arrayToObject": "$kv"
        },
        {
         "incubadora": "$_id",
         "temp_tag": "$temp_tag",
         "uta_tag": "$uta_tag"
        }
       ]
      }
     }
    },
    {
     "$project": {
      "alarma_alta_plc": "$BIT_ALARMA_ALTA_TEMP",
      "alarma_baja_plc": "$BIT_ALARMA_BAJA_TEMP",
      "banda_max_c": "$BANDA_MAX_TEMP",
      "banda_min_c": "$BANDA_MIN_TEMP",
      "especie_codigo": "$TIPO_ESPECIE",
      "habilitada": "$HABILITAR_ZJ",
      "incubadora": 1,
      "loop": "$LOOP_ACTIVO",
      "pct_desarrollo": "$PORCENTAJE_DESARROLLO",
      "temp_c": "$TEMP",
      "temp_tag": 1,
      "test_1": "$TEST_1",
      "test_2": "$TEST_2",
      "test_3": "$TEST_3",
      "test_4": "$TEST_4",
      "test_5": "$TEST_5",
      "tipo_test": "$TIPO_TEST",
      "uta_acumulada": "$UTA_ACUMULADA",
      "uta_tag": 1
     }
    },
    {
     "$sort": {
      "incubadora": 1
     }
    }
   ],
   "formato": "filas tal cual"
  },
